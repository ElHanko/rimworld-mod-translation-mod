    {
      "type": "def",
      "package_id": "vanillaexpanded.vwehw",
      "def_type": "ThingDef",
      "def_name": "VWE_Gun_HeavyFlamer",
      "path": "VWE_Gun_HeavyFlamer.description",
      "english": "A powerful, military-grade flamer based on mechanoid inferno spewers. It can cover the entire area in front of the user in flames.\\n\\nBeing an extremely heavy weapon, this gun requires a power armor to be effectively used.\\n\\nThis weapon has limited number of uses.",
      "hint": null,
      "def_resolution": "resolved",
      "translations": {
        "German": {
          "text": "Ein leistungsstarker militärischer Flammenwerfer, der auf den Inferno-Speiern der Mechanoiden basiert. Er kann den gesamten Bereich vor dem Träger in Flammen hüllen.\n\nDa es sich um eine extrem schwere Waffe handelt, ist für ihren effektiven Einsatz eine Powerrüstung erforderlich.\n\nDiese Waffe kann nur begrenzt oft eingesetzt werden.",
          "review": false,
          "needed": true
        }
      }
    },
