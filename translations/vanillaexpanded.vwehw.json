    {
      "type": "def",
      "package_id": "vanillaexpanded.vwehw",
      "def_type": "ThingDef",
      "def_name": "VWE_Gun_UraniumSlugRifle",
      "path": "VWE_Gun_UraniumSlugRifle.description",
      "english": "A self-loading uranium slug cannon. Its ultra-dense uranium shells can punch through heavy armor. It's more accurate at longer ranges, and can't fire at all close up.\\n\\nBeing an extremely heavy weapon, this gun requires a power armor to be effectively used.\\n\\nThis weapon has limited number of uses.",
      "hint": null,
      "def_resolution": "resolved",
      "translations": {
        "German": {
          "text": "Eine selbstladende Uranprojektilkanone. Ihre ultradichten Urangeschosse können selbst schwere Panzerung durchschlagen. Auf größere Entfernungen ist sie präziser, kann jedoch Ziele in unmittelbarer Nähe überhaupt nicht beschießen.\n\nDa es sich um eine extrem schwere Waffe handelt, ist für ihren effektiven Einsatz eine Powerrüstung erforderlich.\n\nDiese Waffe kann nur begrenzt oft eingesetzt werden.",
          "review": false,
          "needed": true
        }
      }
