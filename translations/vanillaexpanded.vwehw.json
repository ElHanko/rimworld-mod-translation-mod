    {
      "type": "def",
      "package_id": "vanillaexpanded.vwehw",
      "def_type": "ThingDef",
      "def_name": "VWE_Gun_Autocannon",
      "path": "VWE_Gun_Autocannon.description",
      "english": "A self-loading large-bore cannon. Its large-caliber shells do heavy damage over significant ranges. It's slow to aim and it cannot fire at close-up targets.\\n\\nBeing an extremely heavy weapon, this gun requires a power armor to be effectively used.\\n\\nThis weapon has limited number of uses.",
      "hint": null,
      "def_resolution": "resolved",
      "translations": {
        "German": {
          "text": "Eine selbstladende großkalibrige Kanone. Ihre großkalibrigen Geschosse verursachen auf beträchtliche Entfernung schweren Schaden. Das Zielen dauert lange und Ziele in unmittelbarer Nähe können nicht beschossen werden.\n\nDa es sich um eine extrem schwere Waffe handelt, ist für ihren effektiven Einsatz eine Powerrüstung erforderlich.\n\nDiese Waffe kann nur begrenzt oft eingesetzt werden.",
          "review": false,
          "needed": true
        }
      }
    },
