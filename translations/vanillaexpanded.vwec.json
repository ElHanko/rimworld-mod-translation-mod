      "def_name": "VWE_MassDrivers",
      "path": "VWE_MassDrivers.description",
      "english": "Assemble weapons which utilize electromagnets to catapult sabots up to hypervelocity, penetrating thick armor and piercing through targets alike. Note that these also require advanced components.",
      "hint": null,
      "def_resolution": "resolved",
      "translations": {
        "German": {
          "text": "Ermöglicht die Herstellung von Waffen, die Elektromagnete nutzen, um Treibspiegelgeschosse auf Hypergeschwindigkeit zu beschleunigen. Dadurch können sie dicke Panzerung und mehrere Ziele durchschlagen. Für ihre Herstellung werden außerdem fortschrittliche Komponenten benötigt.",
          "review": false,
          "needed": true
        }
      }
