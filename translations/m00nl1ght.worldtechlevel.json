      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:61",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert Gegenstände, die in Lagerzoneneinstellungen und an anderen Stellen der Benutzeroberfläche angezeigt werden. An einigen Stellen erscheinen diese Gegenstände als „(unentdeckt)“ oder werden in einer Kategorie „Unentdeckt“ zusammengefasst.",
          "review": false,
          "needed": true
        }
      }
