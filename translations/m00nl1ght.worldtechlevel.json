    {
      "english": "Filters factions based on the tech level defined by their author. Also applies to temporary factions generated for quests.",
      "key": "WorldTechLevel.Settings.Filter_Factions.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:40",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert Fraktionen anhand der von ihrem Autor festgelegten Techstufe. Gilt auch für temporäre Fraktionen, die für Quests erzeugt werden.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Filters research projects available to the player. Also filters the corresponding techprints.",
      "key": "WorldTechLevel.Settings.Filter_Research.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:41",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert Forschungsprojekte, die dem Spieler zur Verfügung stehen. Filtert außerdem die zugehörigen Techpläne.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Filters quest rewards, trader stock and other randomly generated sources of items in the world.",
      "key": "WorldTechLevel.Settings.Filter_Items.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:42",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert Questbelohnungen, Händlerbestände und andere zufällig erzeugte Quellen für Gegenstände in der Welt.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Filters out quests and quest sub nodes that contain content exceeding the world's tech level. Only filters vanilla and DLC quests, mod-added quests are not filtered. Does not reduce the overall amount of quests given.",
      "key": "WorldTechLevel.Settings.Filter_Quests.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:43",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert Quests und Quest-Unterknoten heraus, deren Inhalte die Welt-Techstufe überschreiten. Es werden nur Quests aus dem Basisspiel und den DLCs gefiltert; von Mods hinzugefügte Quests werden nicht gefiltert. Die Gesamtzahl der vergebenen Quests wird dadurch nicht verringert.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Filters out storyteller-triggered incidents that contain content exceeding the world's tech level, for example mech clusters or toxic fallout in a medieval world. Only filters vanilla and DLC incidents, mod-added incidents are not filtered.",
      "key": "WorldTechLevel.Settings.Filter_Incidents.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:44",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert vom Geschichtenerzähler ausgelöste Ereignisse heraus, deren Inhalte die Welt-Techstufe überschreiten, zum Beispiel Mech-Cluster oder toxischen Fallout in einer mittelalterlichen Welt. Es werden nur Ereignisse aus dem Basisspiel und den DLCs gefiltert; von Mods hinzugefügte Ereignisse werden nicht gefiltert.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Replaces creatures that exceed the world's tech level with the closest alternatives that do not. For example, ensures that quest sites and incidents such as visitor arrival generate with appropriate creatures. Only affects vanilla and DLC creatures. Does not affect anything added by other mods, unless specifically configured to do so by their authors.",
      "key": "WorldTechLevel.Settings.Filter_PawnKinds.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:45",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Ersetzt Kreaturen, die die Welt-Techstufe überschreiten, durch die ähnlichsten Alternativen, die sie nicht überschreiten. So wird zum Beispiel sichergestellt, dass Quest-Orte und Ereignisse wie die Ankunft von Besuchern mit passenden Kreaturen erzeugt werden. Betrifft nur Kreaturen aus dem Basisspiel und den DLCs. Inhalte anderer Mods werden nicht beeinflusst, sofern deren Autoren dies nicht ausdrücklich entsprechend konfiguriert haben.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Checks worn apparel after a creature is newly generated. If any piece of apparel exceeds the world's tech level, that specific piece is replaced with the equivalent of lower tech level, for example Flak Jacket -> Plate Armor.\\n\\nOnly ever affects creatures that would have generated with apparel that exceeds the world's tech level, does not mess with anything else.",
      "key": "WorldTechLevel.Settings.Filter_Apparel.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:46",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Prüft die getragene Kleidung, nachdem eine Kreatur neu erzeugt wurde. Überschreitet ein Kleidungsstück die Welt-Techstufe, wird genau dieses Stück durch eine entsprechende Variante mit niedrigerer Techstufe ersetzt, zum Beispiel Flakweste -> Plattenrüstung.\\n\\nBetrifft ausschließlich Kreaturen, die mit Kleidung oberhalb der Welt-Techstufe erzeugt worden wären, und verändert sonst nichts.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Checks equipped weapons after a creature is newly generated. If the weapon exceeds the world's tech level, it is replaced with the lower tech level equivalent of the same weapon class, for example Assault Rifle -> Recurve Bow.\\n\\nOnly ever affects creatures that would have generated with weapons that exceed the world's tech level, does not mess with anything else.",
      "key": "WorldTechLevel.Settings.Filter_Weapons.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:47",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Prüft ausgerüstete Waffen, nachdem eine Kreatur neu erzeugt wurde. Überschreitet die Waffe die Welt-Techstufe, wird sie durch eine entsprechende Waffe derselben Klasse mit niedrigerer Techstufe ersetzt, zum Beispiel Sturmgewehr -> Recurvebogen.\\n\\nBetrifft ausschließlich Kreaturen, die mit Waffen oberhalb der Welt-Techstufe erzeugt worden wären, und verändert sonst nichts.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Filters initial inventory items that colonists and enemies can generate with, such as food, medicine and drugs.",
      "key": "WorldTechLevel.Settings.Filter_Possessions.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:48",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert Gegenstände im Startinventar, mit denen Kolonisten und Feinde erzeugt werden können, etwa Nahrung, Medizin und Drogen.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Filters artificial body parts and prosthetics already installed in the bodies of colonists and enemies when they are generated.",
      "key": "WorldTechLevel.Settings.Filter_Prosthetics.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:49",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert künstliche Körperteile und Prothesen, die bei der Erzeugung bereits in den Körpern von Kolonisten und Feinden installiert sind.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "tech level",
      "key": "WorldTechLevel.TechLevel",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:5",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Techstufe",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Filters backstories based on assumed tech level. Note that the classification is keyword based and not perfect. If you spot any backstory that slipped through, please report it in the Bug Reports section on the Steam workshop page.",
      "key": "WorldTechLevel.Settings.Filter_Backstories.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:50",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert Hintergrundgeschichten anhand einer angenommenen Techstufe. Die Einstufung basiert auf Schlüsselwörtern und ist nicht perfekt. Wenn dir eine Hintergrundgeschichte auffällt, die durchgerutscht ist, melde sie bitte im Bereich „Bug Reports“ auf der Steam-Workshop-Seite.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Prevents creatures from generating with traits that conflict with the word's tech level, such as the Transhumanist trait in a medieval world.",
      "key": "WorldTechLevel.Settings.Filter_Traits.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:51",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Verhindert, dass Kreaturen mit Eigenschaften erzeugt werden, die der Welt-Techstufe widersprechen, zum Beispiel mit der Eigenschaft „Transhumanist“ in einer mittelalterlichen Welt.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Filters technology related diseases such as Sensory Mechanites if the world's tech level is below Ultra.",
      "key": "WorldTechLevel.Settings.Filter_Diseases.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:52",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert technologiebezogene Krankheiten wie sensorische Mechaniten, wenn die Welt-Techstufe unter Ultra liegt.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Prevents addictions from randomly being applied to generated creatures if the corresponding drug would be unobtainable because it exceeds the world's tech level.",
      "key": "WorldTechLevel.Settings.Filter_Addictions.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:53",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Verhindert, dass erzeugten Kreaturen zufällig Abhängigkeiten zugewiesen werden, wenn die entsprechende Droge nicht erhältlich wäre, weil sie die Welt-Techstufe überschreitet.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "If the world's tech level is below Industrial, prevents gunshot wounds/scars from randomly being applied to creatures when they are generated.",
      "key": "WorldTechLevel.Settings.Filter_DamageTypes.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:54",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Liegt die Welt-Techstufe unter industriell, verhindert dies, dass erzeugten Kreaturen zufällig Schusswunden oder Schussnarben zugewiesen werden.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Filters possible memes and precepts of ideoligions. Affects both randomly generated faction ideoligions and the player ideoligion editor.",
      "key": "WorldTechLevel.Settings.Filter_Ideoligions.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:55",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert mögliche Glaubensgrundlagen und Gebote von Ideologien. Betrifft sowohl zufällig erzeugte Fraktionsideologien als auch den Ideologie-Editor des Spielers.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Filters possible options when a xenotype is randomly assigned to a creature. Does not affect creatures that are generated with a fixed xenotype, for example as part of some quests.",
      "key": "WorldTechLevel.Settings.Filter_Xenotypes.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:56",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert die möglichen Optionen, wenn einer Kreatur zufällig ein Xenotyp zugewiesen wird. Kreaturen mit fest vorgegebenem Xenotyp werden nicht beeinflusst, zum Beispiel wenn sie als Teil bestimmter Quests erzeugt werden.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Filters the materials of ruins and other structures on the map. Only affects map generation.",
      "key": "WorldTechLevel.Settings.Filter_BuildingMaterials.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:57",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert die Materialien von Ruinen und anderen Strukturen auf der Karte. Betrifft nur die Kartengenerierung.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Filters mineable ores generated on the map. For example, Compacted Components will not appear if the world's tech level is below Industrial. Also affects meteors.",
      "key": "WorldTechLevel.Settings.Filter_MineableResources.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:58",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert abbaubare Erze, die auf der Karte erzeugt werden. Beispielsweise erscheinen verdichtete Komponenten nicht, wenn die Welt-Techstufe unter industriell liegt. Betrifft außerdem Meteoriten.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "Filters ancient structures and debris on the map, such as derelict vehicles, mechanoid parts and other junk.",
      "key": "WorldTechLevel.Settings.Filter_GenSteps.Hint",
      "package_id": "m00nl1ght.worldtechlevel",
      "source": "Keys.xml:59",
      "type": "keyed",
      "translations": {
        "German": {
          "text": "Filtert antike Strukturen und Trümmer auf der Karte, etwa verlassene Fahrzeuge, Mechanoidteile und anderen Schrott.",
          "review": false,
          "needed": true
        }
      }
    },
    {
      "english": "world tech level",
      "key": "WorldTechLevel.WorldTechLevel",
      "package_id": "m00nl1ght.worldtechlevel",
